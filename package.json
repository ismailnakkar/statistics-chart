{
    "name": "@ismailnakkar/statistics-chart",
    "version": "0.3.0",
    "description": "The stylesheet and script for the charts of ismailnakkar/laravel-statistics: their layout, metric tabs and axes, and a context line that follows the day under the pointer, touch or keyboard.",
    "keywords": [
        "chart",
        "line-chart",
        "statistics",
        "laravel"
    ],
    "homepage": "https://github.com/ismailnakkar/statistics-chart",
    "bugs": {
        "url": "https://github.com/ismailnakkar/statistics-chart/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ismailnakkar/statistics-chart.git"
    },
    "license": "MIT",
    "author": {
        "name": "Ismail Nakkar",
        "email": "juge.steam@gmail.com"
    },
    "type": "module",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./style.css": {
            "types": "./src/style.d.css.ts",
            "default": "./src/style.css"
        }
    },
    "files": [
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "vitest run",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "happy-dom": "^21.0.4",
        "vitest": "^5.1.0"
    }
}
